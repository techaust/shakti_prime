{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "prototype",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4100",
        "--bind",
        "127.0.0.1",
        "--directory",
        "docs/13-client-packs/prototype"
      ],
      "port": 4100
    }
  ]
}
