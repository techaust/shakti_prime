# The voice worker's environment (SECURITY §3.4): the vendor keys its turn needs and LiveKit's agent
# credentials, nothing of the BOS's. No database URL, signing key, service role or BOS API key: the
# session's 5-minute token, handed over when LiveKit dispatches the worker, is its only way in.
# Set on LiveKit Cloud Agents for dev and staging only; empty on production until the final phase.
# LiveKit's project and the worker's agent credentials, read by the Agents framework itself.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Speech to text and text to speech (Sarvam AI); empty, the worker takes typed questions only.
SARVAM_API_KEY=
SARVAM_STT_MODEL=
SARVAM_TTS_MODEL=
SARVAM_TTS_SPEAKER=
# Teach's interview and drafts (Anthropic); Ask runs its model on the BOS, not here.
ANTHROPIC_API_KEY=
