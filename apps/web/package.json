{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "description": "Shakti Prime web app: public site, BOS app and /api/v1",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "js-budget": "tsx scripts/check-js-budget.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:security": "vitest run --config vitest.security.config.ts",
    "e2e:seed": "tsx e2e/setup/seed.ts",
    "e2e": "pnpm run e2e:seed && playwright test",
    "test:e2e": "pnpm run e2e",
    "e2e:snap": "pnpm run e2e:seed && tsx e2e/setup/snap-in-linux.ts",
    "invite-executive": "tsx scripts/invite-executive.ts",
    "qstash-schedule": "tsx scripts/qstash-schedule.ts",
    "spike:print": "tsx scripts/spike/print.ts",
    "spike:ocr": "tsx scripts/spike/ocr.ts",
    "realtime-keys": "tsx scripts/realtime-keys.ts",
    "realtime-spike": "tsx scripts/realtime-spike.ts",
    "spike:exotel": "tsx scripts/spike/exotel-dial.ts",
    "spike:whatsapp": "tsx scripts/spike/whatsapp.ts",
    "spike:voice": "tsx scripts/spike/voice-latency.ts",
    "spike:tally": "tsx scripts/spike/tally-read.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1141.0",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/client-sesv2": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@node-rs/argon2": "^2.2.1",
    "@sentry/nextjs": "^11.0.0",
    "@shakti/contracts": "workspace:*",
    "@shakti/db": "workspace:*",
    "@shakti/domain": "workspace:*",
    "@shakti/tokens": "workspace:*",
    "@shakti/ui": "workspace:*",
    "@sparticuz/chromium": "^153.0.0",
    "@upstash/qstash": "^2.11.3",
    "@upstash/redis": "^1.39.0",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.13.0",
    "next": "^16.3.6",
    "next-intl": "^4.14.7",
    "next-themes": "^0.4.6",
    "playwright-core": "^1.63.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "~1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "aws-sdk-client-mock": "^4.1.0",
    "jsqr": "^1.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
