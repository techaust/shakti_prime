{
  "expo": {
    "name": "Shakti Field",
    "slug": "shakti-field",
    "version": "1.0.0",
    "scheme": "shaktifield",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["android"],
    "android": {
      "package": "com.shaktiprime.field",
      "versionCode": 1,
      "allowBackup": false
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-local-authentication"],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiBaseUrl": "https://shaktiprime.com/api/v1"
    }
  }
}
