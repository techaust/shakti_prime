{
  "expo": {
    "name": "Shakti Field",
    "slug": "shakti-field",
    "version": "1.0.0",
    "scheme": "shaktifield",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["android"],
    "android": {
      "package": "com.shaktiprime.field",
      "versionCode": 1,
      "allowBackup": false,
      "permissions": ["USE_BIOMETRIC", "USE_FINGERPRINT"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        { "faceIDPermission": "Shakti Field uses your fingerprint or face to open the app." }
      ]
    ],
    "experiments": { "typedRoutes": false },
    "extra": {
      "apiBaseUrl": "https://shaktiprime.com/api/v1"
    }
  }
}
