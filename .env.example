# Copy to .env for local development. Real .env files are never committed.
# These values match compose.yaml, which runs the Supabase Postgres image locally.

# Application connection: the non-superuser app_user, subject to RLS.
DATABASE_URL=postgres://app_user:app_user_local@localhost:54322/postgres

# Migration and seed connection: the table owner. Never used by application code.
DATABASE_URL_MIGRATOR=postgres://postgres:postgres_local@localhost:54322/postgres

# Password given to app_user when the first migration creates the role.
APP_USER_PASSWORD=app_user_local

# Auth module connection: auth_service, the only role that reads session tokens and password hashes.
DATABASE_URL_AUTH=postgres://auth_service:auth_service_local@localhost:54322/postgres
AUTH_SERVICE_PASSWORD=auth_service_local

# Outbox publisher connection: outbox_publisher, which reads outbox_events and marks deliveries.
DATABASE_URL_OUTBOX=postgres://outbox_publisher:outbox_publisher_local@localhost:54322/postgres
OUTBOX_PUBLISHER_PASSWORD=outbox_publisher_local

# Query connection: app_reader, select only under the same policies as app_user. Optional: without
# it executeQuery() reads on app_user in a read-only transaction. Without APP_READER_PASSWORD the
# migrations still create the role, with no password, so no one can sign in as it.
DATABASE_URL_READER=postgres://app_reader:app_reader_local@localhost:54322/postgres
APP_READER_PASSWORD=app_reader_local

# PEM text of the Supabase root certificate. Hosted only: every pool refuses a hosted database
# without it and verifies the server against it (docs/runbooks/DEPLOY.md). Leave empty locally.
DATABASE_CA_CERT=

# Never set. The security suites migrate, seed and leave test users behind, so they refuse any
# database that is not on this machine; ALLOW_REMOTE_TEST_DB=1 turns that guard off.
ALLOW_REMOTE_TEST_DB=

# Better Auth (apps/web). The secret signs cookies; this value is for local use only.
BETTER_AUTH_SECRET=local-only-secret-change-me-0123456789
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare Turnstile. These are Cloudflare's published test keys: the widget always passes.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Upstash Redis (lockouts, principal cache, request caps). Leave empty locally: an in-memory store
# is used. A production deployment refuses to start without it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Mail. Locally the console mailer is always used, whatever this says: it prints invite and reset
# links to the server log. Only a hosted runtime reads MAILER: until the SES provider lands
# (Phase 1) a hosted environment must set MAILER=log, which records that a message went out and
# never the message, and production refuses to start until the provider exists.
MAILER=console

# Which environment this is. Leave it unset for `pnpm dev`. `local` is only for a production build
# started on this machine (`next start` for the end-to-end journeys and Lighthouse; Playwright sets
# it itself): it counts only with BETTER_AUTH_URL on localhost, 127.0.0.1 or [::1], and never on a
# hosted environment, which sets dev, staging or production.
# BOS_ENVIRONMENT=

# Upstash QStash (the outbox publisher and workers). Leave empty locally: the publisher then runs
# in the dev server after each change and sends nothing. A hosted deployment refuses to start
# without the token and both signing keys. QSTASH_URL is the regional endpoint, when not the default.
QSTASH_TOKEN=
QSTASH_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# BOS token signing keys (ADR 0003): private P-256 keys as one-line JWK JSON, made by
# `pnpm --silent --filter web realtime-keys`. The current key signs Realtime tokens; the next key is
# only published in /.well-known/jwks.json until a rotation promotes it. Leave empty locally:
# /api/v1/realtime/token then answers unavailable. Never commit a real value.
BOS_JWT_CURRENT_KEY=
BOS_JWT_NEXT_KEY=

# Vendor harnesses for the week 6 spikes (docs/spikes/). Nothing in the app reads these yet; only
# the `pnpm --filter web spike:*` scripts do, and each refuses to run until its values are set.
# Leave them empty here and put sandbox values in your own .env only. The spike-only variables
# (numbers to dial, test recipients, folders) are listed in each spike note.
# Exotel: account SID, API key and token, cluster (api.in.exotel.com), and the secret that signs
# each call's status-callback address.
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=
EXOTEL_CALLBACK_SECRET=
# WhatsApp Cloud API: the number id, a system-user access key, the app secret that signs webhooks,
# and the verify phrase for Meta's subscription check.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=
# Speech and voice: Sarvam AI, the Claude API and LiveKit Cloud.
SARVAM_API_KEY=
# Voice spike only: the Sarvam speech-to-text model, speech model and voice to compare; empty uses
# the defaults in apps/web/src/integrations/voice/sarvam.ts.
SARVAM_STT_MODEL=
SARVAM_TTS_MODEL=
SARVAM_TTS_SPEAKER=
ANTHROPIC_API_KEY=
# The model the voice spike times; empty uses claude-sonnet-5 (blueprint §9.2). Production calls
# go through the ADR 0011 provider wrapper.
VOICE_SPIKE_MODEL=
# Voice spike only: the reasoning effort it times, `low` (the default), `medium` or `high`.
VOICE_SPIKE_EFFORT=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Tally spike: the Tally XML server on the accounts machine and a connector key made for the spike.
TALLY_URL=
TALLY_CONNECTOR_ID=
TALLY_CONNECTOR_KEY=
