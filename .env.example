# Copy to .env for local development. Real .env files are never committed.
# These values match compose.yaml, which runs the Supabase Postgres image locally.

# Application connection: the non-superuser app_user, subject to RLS.
DATABASE_URL=postgres://app_user:app_user_local@localhost:54322/postgres

# Migration and seed connection: the table owner. Never used by application code.
DATABASE_URL_MIGRATOR=postgres://postgres:postgres_local@localhost:54322/postgres

# Password given to app_user when the first migration creates the role.
APP_USER_PASSWORD=app_user_local

# Auth module connection: auth_service, the only role that reads session tokens and password hashes.
DATABASE_URL_AUTH=postgres://auth_service:auth_service_local@localhost:54322/postgres
AUTH_SERVICE_PASSWORD=auth_service_local

# Outbox publisher connection: outbox_publisher, which reads outbox_events and marks deliveries.
DATABASE_URL_OUTBOX=postgres://outbox_publisher:outbox_publisher_local@localhost:54322/postgres
OUTBOX_PUBLISHER_PASSWORD=outbox_publisher_local

# Query connection: app_reader, select only under the same policies as app_user. Optional: without
# it executeQuery() reads on app_user in a read-only transaction. Without APP_READER_PASSWORD the
# migrations still create the role, with no password, so no one can sign in as it.
DATABASE_URL_READER=postgres://app_reader:app_reader_local@localhost:54322/postgres
APP_READER_PASSWORD=app_reader_local

# Webhook connection: webhook_receiver, which may only store a provider delivery that passed its
# check (app.webhook_receive()) and reads nothing. Optional: without it the webhook routes answer
# that the channel is unavailable. Without WEBHOOK_RECEIVER_PASSWORD the migrations still create the
# role, with no password, so no one can sign in as it.
DATABASE_URL_WEBHOOKS=postgres://webhook_receiver:webhook_receiver_local@localhost:54322/postgres
WEBHOOK_RECEIVER_PASSWORD=webhook_receiver_local

# PEM text of the Supabase root certificate. Hosted only: every pool refuses a hosted database
# without it and verifies the server against it (docs/runbooks/deploy.md). Leave empty locally.
DATABASE_CA_CERT=

# Never set. The security suites migrate, seed and leave test users behind, so they refuse any
# database that is not on this machine; ALLOW_REMOTE_TEST_DB=1 turns that guard off.
ALLOW_REMOTE_TEST_DB=

# Better Auth (apps/web). The secret signs cookies; this value is for local use only.
BETTER_AUTH_SECRET=local-only-secret-change-me-0123456789
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare Turnstile. These are Cloudflare's published test keys: the widget always passes.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Upstash Redis (lockouts, principal cache, request caps). Leave empty locally: an in-memory store
# is used. A production deployment refuses to start without it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Mail. Locally the console mailer is always used, whatever this says: it prints invite and reset
# links to the server log. Only a hosted runtime reads MAILER: MAILER=ses sends through Amazon SES
# in Mumbai from SES_FROM, the verified sender; dev and staging may instead set MAILER=log, which
# records that a message went out and never the message. Production accepts only ses.
MAILER=console
# SES_FROM=

# File storage and field encryption (docs/runbooks/files-setup.md). Leave the storage variables
# empty locally: uploads then go to apps/web/.data/files through the development upload route, and
# nothing scans them. A hosted runtime without FILES_BUCKET and FILES_KMS_KEY_ID answers that
# uploads are unavailable. The AWS keys are the environment's own IAM user's, never a person's.
# FILES_BUCKET=
# FILES_KMS_KEY_ID=
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# The master key for field encryption (bank details) on a developer's machine: 32 bytes in base64.
# This value is 32 zero bytes, which protects nothing and is meant to: local data is test data, and
# a key-like literal would fail the secret scan, which reads the whole history. Empty, a feature
# that seals values answers that it is unavailable. Never set it on a hosted environment: a hosted
# deployment refuses to start with it and seals with its KMS key (FILES_KMS_KEY_ID) instead.
FIELD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Which environment this is. Leave it unset for `pnpm dev`. `local` is only for a production build
# started on this machine (`next start` for the end-to-end journeys and Lighthouse; Playwright sets
# it itself): it counts only with BETTER_AUTH_URL on localhost, 127.0.0.1 or [::1], and never on a
# hosted environment, which sets dev, staging or production.
# BOS_ENVIRONMENT=

# The address the end-to-end journeys open (docs/09-testing.md §5): the same as BETTER_AUTH_URL.
# Unset, they use http://localhost:3031. A slice worktree's .env sets it to the worktree's own app
# port (tools/integration/setup-worktree.sh, which adds it only when this line is absent, so it
# stays commented here). In this checkout, with the dev server stopped:
# E2E_BASE_URL=http://localhost:3000

# Upstash QStash (the outbox publisher and workers). Leave empty locally: the publisher then runs
# in the dev server after each change and sends nothing. A hosted deployment refuses to start
# without the token and both signing keys. QSTASH_URL is the regional endpoint, when not the default.
QSTASH_TOKEN=
QSTASH_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Sentry (the group's US-region organisation). Leave every one empty locally and in CI: without a
# DSN nothing is started or loaded. SENTRY_DSN reports server errors, NEXT_PUBLIC_SENTRY_DSN (the
# same DSN) browser errors, loaded after the page is idle. SENTRY_AUTH_TOKEN, SENTRY_ORG and
# SENTRY_PROJECT upload source maps at build time; without the token the build skips Sentry.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# The agents' AI services, through the provider wrapper (ADR 0011). Both optional: leave them empty
# locally, in CI and on every environment until the owner adds a key; without ANTHROPIC_API_KEY the
# agents make no calls and say the service is unavailable, and without VOYAGE_API_KEY nothing is
# embedded. No runtime refuses to start without them.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# `fake` uses the stand-in AI transport instead of the vendors, on this machine only (a hosted
# runtime refuses to start with it): the Knowledge Vault's journey sets it, and a developer may set
# it to try the vault without a key. Leave it empty otherwise.
AI_TRANSPORT=

# The folder holding `eng.traineddata.gz`, the English OCR model the masking step reads: it covers
# Aadhaar and bank account numbers on vault photos and PDF pages before they are kept or sent to a
# model (docs/04-architecture-appendix/ocr.md). Never fetched from the internet. Without it a vault photo or PDF
# waits in its checks. `pnpm --filter web spike:ocr` fetches the model once into
# %LOCALAPPDATA%/shakti-prime/tesseract/4.0.0_best_int (or ~/.cache/shakti-prime/tesseract/4.0.0_best_int).
OCR_LANG_PATH=

# Browser push (docs/03-roadmap-appendix/phase1.md §8.1): the VAPID key pair and the mailto: or https: address
# the push services may write to. All optional: leave them empty locally and in CI; without all
# three no alert is sent and notices still reach the notification centre.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# BOS token signing keys (ADR 0003): private P-256 keys as one-line JWK JSON, made by
# `pnpm --silent --filter web realtime-keys`. The current key signs Realtime tokens; the next key is
# only published in /.well-known/jwks.json until a rotation promotes it. Leave empty locally:
# /api/v1/realtime/token then answers unavailable. Never commit a real value.
BOS_JWT_CURRENT_KEY=
BOS_JWT_NEXT_KEY=

# Vendor harnesses for the week 6 spikes (docs/04-architecture-appendix/). Nothing in the app reads these yet; only
# the `pnpm --filter web spike:*` scripts do, and each refuses to run until its values are set.
# Leave them empty here and put sandbox values in your own .env only. The spike-only variables
# (numbers to dial, test recipients, folders) are listed in each spike note.
# Exotel: account SID, API key and token, cluster (api.in.exotel.com), and the secret that signs
# each call's status-callback address.
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=
EXOTEL_CALLBACK_SECRET=
# WhatsApp Cloud API: the number id, a system-user access key, the app secret that signs webhooks,
# and the verify phrase for Meta's subscription check.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=
# Webhooks (docs/03-roadmap-appendix/phase2.md §5.1). Each route answers that the channel is
# unavailable while its secret is empty, as production stays until the final phase. The WhatsApp
# route checks WHATSAPP_APP_SECRET and answers Meta's subscription check with WHATSAPP_VERIFY_TOKEN;
# the Exotel status route checks the address EXOTEL_CALLBACK_SECRET signed; the LiveKit route
# checks LIVEKIT_API_KEY and LIVEKIT_API_SECRET. Lead Ads: the Meta app secret that signs its
# deliveries and its own verify phrase. Google lead forms: the key set on the form in Google Ads.
# Exotel's inbound applet, which signs nothing: the secret path segment of its address.
META_LEADGEN_APP_SECRET=
META_LEADGEN_VERIFY_TOKEN=
GOOGLE_LEADFORM_KEY=
EXOTEL_INCOMING_SECRET=
# Speech and voice: Sarvam AI, the Claude API and LiveKit Cloud. SARVAM_API_KEY also transcribes the
# Knowledge Vault's recordings (K3); set it only once the owner has approved Sarvam's data terms.
SARVAM_API_KEY=
# Voice spike only: the Sarvam speech-to-text model, speech model and voice to compare; empty uses
# the defaults in apps/web/src/integrations/voice/sarvam.ts.
SARVAM_STT_MODEL=
SARVAM_TTS_MODEL=
SARVAM_TTS_SPEAKER=
# ANTHROPIC_API_KEY (the agents' key, above) is also the voice spike's.
# The model the voice spike times; empty uses claude-sonnet-5 (blueprint §9.2). Production calls
# go through the ADR 0011 provider wrapper.
VOICE_SPIKE_MODEL=
# Voice spike only: the reasoning effort it times, `low` (the default), `medium` or `high`.
VOICE_SPIKE_EFFORT=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Tally spike: the Tally XML server on the accounts machine and a connector key made for the spike.
TALLY_URL=
TALLY_CONNECTOR_ID=
TALLY_CONNECTOR_KEY=
