{
  "catalogues": [{ "dir": "apps/web/messages", "locales": ["en"] }],
  "templateDirs": ["packages/contracts/src/templates"],
  "limits": [
    {
      "keyPattern": "\\.(submit|verify|start|switch|signOut|goSignIn|useBackupCode|useAppCode|staffSignIn|primary|secondary|link|unavailable|retry|home)$",
      "max": 24
    },
    { "keyPattern": "\\.[A-Za-z]*[Tt]itle$", "max": 60 },
    { "keyPattern": "^app\\.name$", "max": 30 }
  ]
}
