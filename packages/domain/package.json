    "papaparse": "^5.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/papaparse": "^5.5.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
