{
  "name": "@shakti/domain",
  "version": "0.0.0",
  "private": true,
  "description": "Domain commands, command runner, state machines and calculators. No framework imports.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./redaction": "./src/ports/redaction.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:security": "vitest run --config vitest.security.config.ts",
    "machines:docs": "tsx scripts/machines-docs.ts",
    "spike:import": "tsx tests/spike/import-scale.ts",
    "spike:lists": "tsx tests/spike/lists.ts",
    "spike:account360": "tsx tests/spike/account360.ts",
    "spike:catalogue": "tsx tests/spike/catalogue-explain.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@shakti/contracts": "workspace:*",
    "@shakti/db": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "papaparse": "^5.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/papaparse": "^5.5.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
