{
  "name": "shakti-prime",
  "private": true,
  "description": "Shakti Prime BOS: business operating system for the Shakti group",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:security": "turbo run test:security --concurrency=1",
    "db:generate": "pnpm --filter @shakti/db db:generate",
    "db:migrate": "pnpm --filter @shakti/db db:migrate",
    "db:seed": "pnpm --filter @shakti/db db:seed",
    "db:verify": "pnpm --filter @shakti/db db:verify",
    "db:docs": "pnpm --filter @shakti/db db:docs",
    "copy-lint": "pnpm --filter @shakti/copy-lint start",
    "spike:print": "pnpm --filter web spike:print",
    "spike:ocr": "pnpm --filter web spike:ocr",
    "spike:import": "pnpm --filter @shakti/domain spike:import",
    "spike:lists": "pnpm --filter @shakti/domain spike:lists",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "pnpm -r --filter @shakti/contracts --filter @shakti/domain --filter @shakti/db --filter @shakti/tokens --filter web exec vitest run --coverage --coverage.reporter=text-summary"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.30.0",
    "eslint-config-next": "^16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "turbo": "^2.11.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
