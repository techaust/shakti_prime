{
  "name": "shakti-prime",
  "private": true,
  "description": "Shakti Prime BOS: business operating system for the Shakti group",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:security": "turbo run test:security --concurrency=1",
    "db:generate": "pnpm --filter @shakti/db db:generate",
    "db:migrate": "pnpm --filter @shakti/db db:migrate",
    "db:seed": "pnpm --filter @shakti/db db:seed",
    "copy-lint": "pnpm --filter @shakti/copy-lint start",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "turbo": "^2.11.4",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
