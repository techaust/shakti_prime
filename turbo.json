{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["CI", "NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "src/tokens.css", "src/tailwind.css"],
      "env": ["NEXT_PUBLIC_*", "VERCEL_*", "TURNSTILE_SITE_KEY"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@shakti/db#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/DATABASE.md", "$TURBO_ROOT$/docs/data/**"]
    },
    "@shakti/contracts#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/API.md"]
    },
    "test:security": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_MIGRATOR",
        "DATABASE_URL_AUTH",
        "DATABASE_URL_OUTBOX",
        "APP_USER_PASSWORD",
        "AUTH_SERVICE_PASSWORD",
        "OUTBOX_PUBLISHER_PASSWORD",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "TURNSTILE_SECRET_KEY",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "MAILER",
        "QSTASH_TOKEN",
        "QSTASH_URL",
        "QSTASH_CURRENT_SIGNING_KEY",
        "QSTASH_NEXT_SIGNING_KEY",
        "ALLOW_REMOTE_TEST_DB",
        "DATABASE_CA_CERT",
        "BOS_JWT_CURRENT_KEY",
        "BOS_JWT_NEXT_KEY"
      ]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "env": [
        "DATABASE_URL_MIGRATOR",
        "APP_USER_PASSWORD",
        "AUTH_SERVICE_PASSWORD",
        "OUTBOX_PUBLISHER_PASSWORD"
      ]
    },
    "db:seed": {
      "cache": false,
      "env": ["DATABASE_URL_MIGRATOR"]
    }
  }
}
