{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalEnv": ["CI", "NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "src/tokens.css", "src/tailwind.css"],
      "env": [
        "NEXT_PUBLIC_*",
        "VERCEL_*",
        "TURNSTILE_SITE_KEY",
        "BOS_ENVIRONMENT",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@shakti/db#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/05-database.md", "$TURBO_ROOT$/docs/data/**"]
    },
    "@shakti/tokens#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/web/src/app/icon.svg"]
    },
    "@shakti/contracts#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/06-api.md"]
    },
    "web#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.mjs"]
    },
    "test:security": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_MIGRATOR",
        "DATABASE_URL_AUTH",
        "DATABASE_URL_OUTBOX",
        "APP_USER_PASSWORD",
        "AUTH_SERVICE_PASSWORD",
        "OUTBOX_PUBLISHER_PASSWORD",
        "DATABASE_URL_READER",
        "APP_READER_PASSWORD",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "TURNSTILE_SECRET_KEY",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "MAILER",
        "QSTASH_TOKEN",
        "QSTASH_URL",
        "QSTASH_CURRENT_SIGNING_KEY",
        "QSTASH_NEXT_SIGNING_KEY",
        "ALLOW_REMOTE_TEST_DB",
        "DATABASE_CA_CERT",
        "BOS_JWT_CURRENT_KEY",
        "BOS_JWT_NEXT_KEY",
        "SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_DSN",
        "FILES_BUCKET",
        "FILES_KMS_KEY_ID",
        "AWS_REGION",
        "FIELD_ENCRYPTION_KEY",
        "SES_FROM",
        "ANTHROPIC_API_KEY",
        "VOYAGE_API_KEY",
        "VAPID_PUBLIC_KEY",
        "VAPID_PRIVATE_KEY",
        "VAPID_SUBJECT"
      ]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH", "HOME", "DISPLAY", "XDG_RUNTIME_DIR"],
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_MIGRATOR",
        "DATABASE_URL_AUTH",
        "DATABASE_URL_OUTBOX",
        "APP_USER_PASSWORD",
        "AUTH_SERVICE_PASSWORD",
        "OUTBOX_PUBLISHER_PASSWORD",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "TURNSTILE_SITE_KEY",
        "TURNSTILE_SECRET_KEY",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "MAILER",
        "QSTASH_TOKEN",
        "QSTASH_URL",
        "QSTASH_CURRENT_SIGNING_KEY",
        "QSTASH_NEXT_SIGNING_KEY",
        "ALLOW_REMOTE_TEST_DB",
        "DATABASE_CA_CERT",
        "BOS_JWT_CURRENT_KEY",
        "BOS_JWT_NEXT_KEY",
        "E2E_BASE_URL",
        "E2E_EXTERNAL_APP",
        "ANTHROPIC_API_KEY",
        "VOYAGE_API_KEY",
        "VAPID_PUBLIC_KEY",
        "VAPID_PRIVATE_KEY",
        "VAPID_SUBJECT"
      ]
    },
    "db:generate": {
      "cache": false
    }
  }
}
