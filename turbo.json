{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["CI", "NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "src/tokens.css", "src/tailwind.css"],
      "env": ["NEXT_PUBLIC_*", "VERCEL_*", "TURNSTILE_SITE_KEY"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:security": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_MIGRATOR",
        "DATABASE_URL_AUTH",
        "APP_USER_PASSWORD",
        "AUTH_SERVICE_PASSWORD",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "TURNSTILE_SECRET_KEY",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "MAILER",
        "ALLOW_REMOTE_TEST_DB"
      ]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL_MIGRATOR", "APP_USER_PASSWORD", "AUTH_SERVICE_PASSWORD"]
    },
    "db:seed": {
      "cache": false,
      "env": ["DATABASE_URL_MIGRATOR"]
    }
  }
}
